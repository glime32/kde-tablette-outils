#!/bin/sh
# tablet-toggle [toggle|on|off|status] — bouton « Basculer Clavier ».
# Un seul appel D-Bus au démon clavier-garde (déjà en veille) ; s'il ne tourne
# pas, clavier-garde fait le travail lui-même.
cmd=${1:-toggle}
case "$cmd" in
    toggle) set -- Basculer;          py=basculer ;;
    on)     set -- Tablette b false;  py=on ;;
    off)    set -- Tablette b true;   py=off ;;
    status) set -- Etat;              py=etat ;;
    *) echo "usage : tablet-toggle [toggle|on|off|status]"; exit 2 ;;
esac
busctl --user call org.glime.Tablette /org/glime/Tablette org.glime.Tablette "$@" 2>/dev/null \
    || exec "$HOME/.local/bin/clavier-garde" "$py"
